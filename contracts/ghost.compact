// ==========================================
// GHOST ADVANCED COMPACT CIRCUIT
// ==========================================
// Enterprise ZK Policy & Spending Engine
//
// Core capabilities:
// 1. Threshold commitment management
// 2. Enterprise authorization verification
// 3. Additional authorization for high-value spends
// 4. Controlled spending-limit enforcement
// ==========================================

pragma language_version >= 0.14.0;

import CompactStandardLibrary;

// ------------------------------------------
// Public ledger state
// ------------------------------------------

export ledger spending_limit: Uint<32>;
export ledger total_spent: Uint<32>;

// Commitment representing the enterprise authorization root.
export ledger enterprise_auth_root: Bytes<32>;

// Commitment representing the currently configured threshold.
export ledger threshold_commitment: Bytes<32>;

// ------------------------------------------
// Contract initialization
// ------------------------------------------

constructor(
  limit: Uint<32>,
  auth_root: Bytes<32>,
  initial_threshold_commit: Bytes<32>
) {
  spending_limit = disclose(limit);
  total_spent = 0 as Uint<32>;

  enterprise_auth_root = auth_root;
  threshold_commitment = initial_threshold_commit;
}

// ------------------------------------------
// Threshold management
// ------------------------------------------

// Updates the enterprise threshold commitment after
// validating the administrator authorization.
export circuit rebalance_threshold(
  admin_secret: Bytes<32>,
  new_threshold_commit: Bytes<32>
): [] {
  assert(
    admin_secret == enterprise_auth_root,
    "Unauthorized: Invalid admin secret"
  );

  threshold_commitment = new_threshold_commit;
}

// ------------------------------------------
// Spending authorization
// ------------------------------------------

// Records an authorized transaction while enforcing
// the configured spending ceiling.
//
// Transactions at or above 50,000 require an additional
// enterprise authorization token.
export circuit spend(
  amount: Uint<32>,
  multi_party_token: Bytes<32>
): [] {
  const proposed_total = total_spent + amount;

  // Prevent the cumulative spending balance from
  // exceeding the configured contract limit.
  assert(
    proposed_total <= spending_limit,
    "Absolute spending limit exceeded"
  );

  // Require enterprise authorization for high-value
  // transactions.
  if (amount >= 50000 as Uint<32>) {
    assert(
      multi_party_token == enterprise_auth_root,
      "High-value spend requires valid multi-party ZK approval"
    );
  }

  // Commit the newly calculated spending total.
  total_spent = (
    total_spent + disclose(amount)
  ) as Uint<32>;
}
