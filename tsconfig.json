{
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noImplicitAny": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "sourceMap": true,
    "noEmit": true,
    "incremental": true,
    "skipLibCheck": true,

    "plugins": [
      {
        "name": "next"
      }
    ],

    "paths": {
      "@/*": ["./*"],
      "@ghost/sdk": ["./packages/sdk/src/index.ts"],
      "@ghost/sdk/*": ["./packages/sdk/src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "tests",
    "bboard",
    "ghost-contract",
    "src-vite-old",
    "deploy-simulated.ts"
  ]
}
